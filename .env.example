# Local development configuration example.
#
# Preferred setup:
#   npm run setup:env      # writes .env with random secrets (never overwrites)
#   npm run setup:config   # copies the JSON config templates (never overwrites)
#
# If you copy this file manually, replace every "replace-me" value yourself and
# never commit real secrets. Values here are development placeholders only.
#
# Legend:
#   Required   - the owning process fails at startup without it
#   Derived    - `npm run dev` computes it for the child process from other values
#   Optional   - has a default or is only needed for an optional feature
#   Test-only  - set only by the test suites, never in a normal deployment

# --- Core server (web, worker, scripts) --------------------------------------
# PostgreSQL connection for the application owner role. Required by the web app,
# the worker and every operational script. `npm run dev` also derives each
# restricted agent/MCP role URL from this value plus the passwords below.
DATABASE_URL=postgres://odft:odft_local_password@127.0.0.1:5442/odft
# Disposable database for `npm run test:integration` only. The suite resets its
# schemas, so the name must end in `_test` and must never point at real data.
TEST_DATABASE_URL=postgres://odft:odft_local_password@127.0.0.1:5442/odft_test
# Exact public origin of the web app (cookie/CSRF checks, E2E base URL).
PUBLIC_BASE_URL=http://localhost:3000
# HMAC key for session cookies. Required, at least 32 characters.
# `npm run setup:env` generates it.
SESSION_HMAC_KEY=replace-me

# --- AI configuration --------------------------------------------------------
# fixture (default; no credentials, no profile file, no network egress) or
# openrouter (live model calls).
AI_MODE=fixture
# Required only when AI_MODE=openrouter.
# OPENROUTER_API_KEY=
# Required only when AI_MODE=openrouter. Path to the role-profile JSON file
# (all four roles: intent/recommendation/planner/reviewer). Relative paths
# resolve from the repository root. `npm run setup:config` creates it from
# ai-profiles.example.json; `npm run validate:models` verifies it and stamps the
# pricing version. See README "AI modes and configuration".
# AI_CONFIG_PATH=./ai-profiles.json

# --- Business limits ---------------------------------------------------------
# Optional bounds; the values below are the example overrides.
MAX_PLANNING_ATTEMPTS=10
MAX_PROVIDER_ATTEMPTS=10
MAX_LLM_CALLS_PER_TRIP=40
MAX_LLM_COST_USD_PER_TRIP=5.00

# --- Voice control (optional, off by default) --------------------------------
# true shows the Dictate controls in the assistant rail. Fixture AI mode needs
# no credentials and no profile file.
VOICE_ENABLED=false
# Live voice only: a DEDICATED OpenRouter STT key restricted to Groq. Never the
# shared OPENROUTER_API_KEY.
# OPENROUTER_STT_API_KEY=
# Live voice only: speech-profile JSON (stt/tts). `npm run setup:config` creates
# it from voice-profiles.example.json; `npm run validate:models` verifies it.
# VOICE_CONFIG_PATH=./voice-profiles.json

# --- Optional / demo controls ------------------------------------------------
DEMO_CONTROLS_ENABLED=true
# Optional public Leaflet tile URL template ({z}/{x}/{y}); unset = SVG fallback.
# Must be credential-free (https when the app is https). See README "Map tiles".
# MAP_TILE_URL=
WORKER_CONCURRENCY=2
# Trust X-Forwarded-For / X-Real-IP for rate-limit buckets. Leave false unless
# the app runs behind a known reverse proxy.
TRUST_PROXY=false
# On-demand Wikidata landmark curation for generic-only cities (off by default,
# never in tests).
# WIKIDATA_DISCOVERY=true

# --- Protocol stack: required for `npm run dev` ------------------------------
# `npm run dev` starts the MCP host and the three primary A2A agents. The
# registry files are committed templates; `npm run setup:config` copies them.
#
# Trusted A2A registry used by the worker/coordinator and by every agent:
# identities, exact origins, pinned card URLs and credentialRef names.
ODFT_AGENT_REGISTRY_PATH=agent-registry.json
# Trusted inbound registry for the MCP host (which agent may call which
# endpoint). Required by the MCP host.
ODFT_MCP_AGENT_REGISTRY_PATH=mcp-host-registry.json
# Trusted MCP endpoints used by the flight agent.
ODFT_MCP_REGISTRY_PATH=mcp-registry.json
# Each specialist presents its OWN token to the MCP host. Never share the flight
# registry with accommodation or City Guide: the identity check would fail.
ODFT_ACCOMMODATION_AGENT_MCP_REGISTRY_PATH=mcp-registry.accommodation.json
ODFT_CITY_GUIDE_AGENT_MCP_REGISTRY_PATH=mcp-registry.city-guide.json
# Bearer tokens referenced by registry credentialRef entries. Required for
# `npm run dev`; never committed. `npm run setup:env` generates each value.
ODFT_AGENT_TOKEN_FLIGHT=replace-me
ODFT_AGENT_TOKEN_ACCOMMODATION=replace-me
ODFT_AGENT_TOKEN_CITY_GUIDE=replace-me
# Distinct coordinator-to-agent bearer (never an agent's own token).
ODFT_COORDINATOR_TOKEN=replace-me
# Passwords for `npm run protocol:roles` (at least 16 characters each). Required
# by `npm run dev`, which derives the restricted-role database URLs from them.
ODFT_PROTOCOL_ROLE_PASSWORD=replace-me
ODFT_MCP_READONLY_PASSWORD=replace-me
ODFT_FLIGHT_AGENT_PASSWORD=replace-me
ODFT_ACCOMMODATION_AGENT_PASSWORD=replace-me
ODFT_CITY_GUIDE_AGENT_PASSWORD=replace-me

# --- Protocol stack: optional or derived by `npm run dev` --------------------
# MCP host bind address and endpoint ports (defaults shown).
# ODFT_MCP_HOST=127.0.0.1
# ODFT_MCP_GEOGRAPHY_PORT=4321
# ODFT_MCP_TRAVEL_DATA_PORT=4322
# ODFT_MCP_ITINERARY_TOOLS_PORT=4323
# Database URLs used by the MCP host. `npm run dev` derives both; set them only
# when starting the host directly:
#   ODFT_MCP_READONLY_DATABASE_URL - read-only role; required by the host
#   ODFT_PROTOCOL_DATABASE_URL     - protocol/auth role; optional, falls back to
#                                    the host's DATABASE_URL
# ODFT_MCP_READONLY_DATABASE_URL=
# ODFT_PROTOCOL_DATABASE_URL=
# Tokens the MCP host presents when it acts as a client. Used only by protocol
# tests; normal `npm run dev` does not need them.
# ODFT_MCP_TOKEN_GEOGRAPHY=
# ODFT_MCP_TOKEN_TRAVEL_DATA=
# ODFT_MCP_TOKEN_ITINERARY_TOOLS=

# --- Flight agent (direct start is optional) ---------------------------------
# `npm run dev` starts the agent on 127.0.0.1:4401 with a derived DATABASE_URL
# and ODFT_FLIGHT_AGENT_REGISTRY_PATH. The values below are needed only when the
# agent runs standalone (for example `npm run dev:flight-agent`). The password in
# each example URL is the generic local placeholder; the real value is the
# matching ODFT_*_AGENT_PASSWORD.
# DATABASE_URL=postgres://odft_flight_agent:odft_local_password@127.0.0.1:5442/odft
# ODFT_FLIGHT_AGENT_REGISTRY_PATH=agent-registry.json
# ODFT_FLIGHT_AGENT_HOST=127.0.0.1
# ODFT_FLIGHT_AGENT_PORT=4401
# Test-only: exit after durable admission, before any work (default 0).
# ODFT_FLIGHT_AGENT_CRASH=0

# --- Accommodation and City Guide agents (direct start is optional) ----------
# Same rule: `npm run dev` derives DATABASE_URL and the registry path. A
# standalone start needs the restricted role connection and the inbound registry.
# DATABASE_URL=postgres://odft_accommodation_agent:odft_local_password@127.0.0.1:5442/odft
# ODFT_ACCOMMODATION_AGENT_REGISTRY_PATH=agent-registry.json
# ODFT_ACCOMMODATION_AGENT_HOST=127.0.0.1
# ODFT_ACCOMMODATION_AGENT_PORT=4402
# Test-only: artificial per-step delay in milliseconds, widening parallel test
# windows (default 0).
# ODFT_ACCOMMODATION_AGENT_STEP_DELAY_MS=0
# ODFT_ACCOMMODATION_AGENT_CRASH=0
# DATABASE_URL=postgres://odft_city_guide_agent:odft_local_password@127.0.0.1:5442/odft
# ODFT_CITY_GUIDE_AGENT_REGISTRY_PATH=agent-registry.json
# ODFT_CITY_GUIDE_AGENT_HOST=127.0.0.1
# ODFT_CITY_GUIDE_AGENT_PORT=4403
# Test-only: per-step delay and crash-before-work hook (defaults 0).
# ODFT_CITY_GUIDE_AGENT_STEP_DELAY_MS=0
# ODFT_CITY_GUIDE_AGENT_CRASH=0

# --- Alternative Accommodation Agent B (replacement demo, optional) ----------
# Not started by `npm run dev`. It uses the restricted accommodation role and its
# own task table; start it only for the replacement demonstration.
ODFT_AGENT_TOKEN_ACCOMMODATION_ALT=replace-me
ODFT_ACCOMMODATION_ALT_AGENT_PASSWORD=replace-me
# DATABASE_URL=postgres://odft_accommodation_agent:odft_local_password@127.0.0.1:5442/odft
# ODFT_ACCOMMODATION_ALT_AGENT_REGISTRY_PATH=agent-registry.json
# Optional MCP registry for this implementation (unset = no outbound MCP calls).
# ODFT_ACCOMMODATION_ALT_AGENT_MCP_REGISTRY_PATH=mcp-registry.accommodation-alt.json
# ODFT_ACCOMMODATION_ALT_AGENT_HOST=127.0.0.1
# ODFT_ACCOMMODATION_ALT_AGENT_PORT=4404
# Optional distinct AI profile; when unset the shared AI_CONFIG_PATH applies.
# ODFT_ACCOMMODATION_ALT_AI_CONFIG_PATH=ai-profiles-alt.json
# Test-only hooks (defaults 0).
# ODFT_ACCOMMODATION_ALT_AGENT_STEP_DELAY_MS=0
# ODFT_ACCOMMODATION_ALT_AGENT_CRASH=0

# --- Disposable verification databases (Phase 12) ---------------------------
# The E2E suite and the comparable benchmark refuse a database whose name does
# not end in `_test`. They reset the schemas of that disposable database, so
# never point them at real data. Example:
#   DATABASE_URL=postgres://odft:odft_local_password@127.0.0.1:5442/odft_phase12_test \
#   PUBLIC_BASE_URL=http://localhost:3100/ \
#   npm run benchmark:baseline -- --output .cache/benchmarks/coordinator-phase12.json
