# Local development configuration example.
#
# Preferred: run `npm run setup:env`, which writes a `.env` with a random
# SESSION_HMAC_KEY and never overwrites an existing file. If you copy this file
# manually, you MUST replace SESSION_HMAC_KEY (the placeholder is intentionally
# too short to pass validation) and never commit real secrets.

# Required server secrets -----------------------------------------------------
DATABASE_URL=postgres://odft:odft_local_password@127.0.0.1:5442/odft
TEST_DATABASE_URL=postgres://odft:odft_local_password@127.0.0.1:5442/odft_test
PUBLIC_BASE_URL=http://localhost:3000
SESSION_HMAC_KEY=replace-me

# AI configuration ------------------------------------------------------------
# fixture (default; no credentials needed) | openrouter
# In openrouter mode BOTH the API key and AI_CONFIG_PATH are required, and the
# worker/script fail closed without them.
AI_MODE=fixture
# OPENROUTER_API_KEY=
# Path to the role-profile JSON file (all four roles: intent/recommendation/
# planner/reviewer). Start from the committed template:
#   cp ai-profiles.example.json ai-profiles.json
# Then run `npm run ai:validate-models`; it refreshes the capability/pricing
# cache at "<AI_CONFIG_PATH>.capabilities.json" and stamps the verified
# pricingVersion into the profiles. See README "AI modes and configuration".
# AI_CONFIG_PATH=./ai-profiles.json

# Business limits -------------------------------------------------------------
MAX_PLANNING_ATTEMPTS=10
MAX_PROVIDER_ATTEMPTS=10
MAX_LLM_CALLS_PER_TRIP=40
MAX_LLM_COST_USD_PER_TRIP=5.00

# Voice control (optional; off by default) ------------------------------------
# Fixture mode (AI_MODE=fixture) needs no credentials and no profile file. Live
# mode additionally requires VOICE_CONFIG_PATH and a DEDICATED OpenRouter STT
# key restricted to Groq — never the shared OPENROUTER_API_KEY. Start from the
# committed template and validate:
#   cp voice-profiles.example.json voice-profiles.json
#   npm run voice:validate-models
# Create the key, then create and ASSIGN a guardrail to it (provider allowlist
# exactly "groq", model allowlist exactly "openai/whisper-large-v3-turbo") — a
# guardrail enforces nothing until assigned. See README "Voice control
# (optional)" for the full runbook and failure behavior.
VOICE_ENABLED=false
# OPENROUTER_STT_API_KEY=
# VOICE_CONFIG_PATH=./voice-profiles.json

# Optional / demo controls ----------------------------------------------------
DEMO_CONTROLS_ENABLED=true
# Optional public Leaflet tile URL template ({z}/{x}/{y}) for the itinerary map.
# Unset = the labeled SVG schematic fallback. Must be credential-free (https when
# the app is https). See README "Map tiles".
# MAP_TILE_URL=
WORKER_CONCURRENCY=2
# Trust X-Forwarded-For / X-Real-IP for the client IP used by pre-session rate
# limits. Leave false unless the app runs behind a known reverse proxy; when
# false, forwarded headers are ignored so they cannot spoof new rate buckets.
TRUST_PROXY=false
# On-demand landmark curation (off by default, never in tests): look a
# generic-only city's landmarks up from Wikidata on the first trip and store
# them so later trips reuse the reference rows.
# WIKIDATA_DISCOVERY=true

# --- Phase 03: agent protocol (A2A) and MCP ---------------------------------
# Trusted agent registry file (exact origins, pinned card URLs, credential refs;
# no secrets inside). See agent-registry.example.json.
# ODFT_AGENT_REGISTRY_PATH=agent-registry.json
# Trusted MCP service registry file.
# ODFT_MCP_REGISTRY_PATH=mcp-registry.json
# This service's own agent identity (inbound admission scoping).
# ODFT_SELF_AGENT_IDENTITY=flight-agent
# Bearer tokens referenced by registry credentialRef entries (never committed).
# ODFT_AGENT_TOKEN_FLIGHT=
# ODFT_AGENT_TOKEN_ACCOMMODATION=
# ODFT_AGENT_TOKEN_CITY_GUIDE=
# ODFT_MCP_TOKEN_GEOGRAPHY=
# Protocol deadlines (milliseconds): card discovery / business call / cache TTL.
# ODFT_A2A_CARD_TIMEOUT_MS=3000
# ODFT_A2A_CALL_TIMEOUT_MS=5000
# ODFT_A2A_CARD_CACHE_TTL_MS=300000
# ODFT_MCP_TIMEOUT_MS=5000
# Passwords for scripts/setup-protocol-roles.ts (>=16 chars, never committed).
# ODFT_PROTOCOL_ROLE_PASSWORD=
# ODFT_MCP_READONLY_PASSWORD=

# --- Phase 04: MCP host (read-only capability endpoints) ---------------------
# Trusted inbound agent registry for the MCP host (identities + credential refs).
# ODFT_MCP_AGENT_REGISTRY_PATH=tests/fixtures/protocols/mcp-host-registry.json
# Endpoint ports (defaults 4321 geography, 4322 travel-data, 4323 itinerary-tools).
# ODFT_MCP_HOST=127.0.0.1
# ODFT_MCP_GEOGRAPHY_PORT=4321
# ODFT_MCP_TRAVEL_DATA_PORT=4322
# ODFT_MCP_ITINERARY_TOOLS_PORT=4323
# Read-only domain/reference role connection (scripts/setup-protocol-roles.ts).
# ODFT_MCP_READONLY_DATABASE_URL=
# Protocol-role connection for delegation authorization reads and observations
# (falls back to DATABASE_URL when unset; see docs/protocols/mcp.md).
# ODFT_PROTOCOL_DATABASE_URL=
# Agent bearer tokens referenced by the registry (never committed).
# ODFT_AGENT_TOKEN_FLIGHT=
# ODFT_AGENT_TOKEN_ACCOMMODATION=
# ODFT_AGENT_TOKEN_CITY_GUIDE=

# --- Phase 05: Flight Agent (delegated A2A service) --------------------------
# The agent's DATABASE_URL must be the restricted odft_flight_agent role
# connection created by scripts/setup-protocol-roles.ts (never the owner role).
# ODFT_FLIGHT_AGENT_PASSWORD=
# DATABASE_URL=postgres://odft_flight_agent:<password>@127.0.0.1:5442/odft
# Inbound trusted identities and the Phase 04 MCP endpoints.
# ODFT_FLIGHT_AGENT_REGISTRY_PATH=agent-registry.json
# ODFT_MCP_REGISTRY_PATH=mcp-registry.json
# ODFT_FLIGHT_AGENT_HOST=127.0.0.1
# ODFT_FLIGHT_AGENT_PORT=4401
# Bearer token the agent presents to the MCP host (registry credentialRef).
# ODFT_AGENT_TOKEN_FLIGHT=
# AI_MODE=fixture (default) or openrouter; openrouter requires AI_CONFIG_PATH
# with a validated recommendation profile and a fresh capability manifest.
# AI_CONFIG_PATH=ai-profiles.json
# Test-only crash-before-work hook.
# ODFT_FLIGHT_AGENT_CRASH=0

# --- Phase 06: Accommodation and City Guide agents (delegated A2A services) ---
# Each agent's DATABASE_URL must be its restricted role connection created by
# scripts/setup-protocol-roles.ts (never the owner role).
# ODFT_ACCOMMODATION_AGENT_PASSWORD=
# DATABASE_URL=postgres://odft_accommodation_agent:<password>@127.0.0.1:5442/odft
# ODFT_CITY_GUIDE_AGENT_PASSWORD=
# DATABASE_URL=postgres://odft_city_guide_agent:<password>@127.0.0.1:5442/odft
# Inbound trusted identities and the Phase 04 MCP endpoints (per-agent files;
# credentialRef entries resolve to the matching ODFT_AGENT_TOKEN_* variable).
# ODFT_ACCOMMODATION_AGENT_REGISTRY_PATH=agent-registry.json
# ODFT_ACCOMMODATION_AGENT_MCP_REGISTRY_PATH=mcp-registry.json
# ODFT_CITY_GUIDE_AGENT_REGISTRY_PATH=agent-registry.json
# ODFT_CITY_GUIDE_AGENT_MCP_REGISTRY_PATH=mcp-registry.json
# ODFT_ACCOMMODATION_AGENT_HOST=127.0.0.1
# ODFT_ACCOMMODATION_AGENT_PORT=4402
# ODFT_CITY_GUIDE_AGENT_HOST=127.0.0.1
# ODFT_CITY_GUIDE_AGENT_PORT=4403
# Test-only step delay widening the observable working window (parallel tests).
# ODFT_ACCOMMODATION_AGENT_STEP_DELAY_MS=0
# ODFT_CITY_GUIDE_AGENT_STEP_DELAY_MS=0
# The accommodation agent shares AI_MODE/AI_CONFIG_PATH with the flight agent
# for its optional governed comparison; the City Guide agent is deterministic.
